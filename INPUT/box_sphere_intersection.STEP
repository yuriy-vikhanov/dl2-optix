ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Simple non-tangent STEP CSG box minus sphere'),'2;1');
FILE_NAME('box_sphere_intersection.step','2026-08-20T00:00:00',('PrefSuite'),('PrefSuite'),'PrefSuite','PrefSuite','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('BOX_MINUS_SPHERE','Box minus sphere','',(#3));
#6=PRODUCT_RELATED_PRODUCT_CATEGORY('detail','',(#5));
#7=PRODUCT_DEFINITION_FORMATION('','',#5);
#8=PRODUCT_DEFINITION('design','',#7,#4);
#9=PRODUCT_DEFINITION_SHAPE('','',#8);
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-6),#10,'distance_accuracy_value','model tolerance');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('Box sphere context','3D Context'));
#15=DIRECTION('',(0.,0.,1.));
#16=DIRECTION('',(1.,0.,0.));
#17=CARTESIAN_POINT('',(0.,0.,0.));
#18=AXIS2_PLACEMENT_3D('',#17,#15,#16);
#19=BLOCK('BOX',#18,100.,100.,100.);
#20=CARTESIAN_POINT('',(80.,50.,50.));
#22=SPHERE('SPHERE',40.,#20);
#23=BOOLEAN_RESULT('BOX_MINUS_SPHERE',.DIFFERENCE.,#19,#22);
#24=CSG_SOLID('BOX_MINUS_SPHERE_ROOT',#23);
#25=CSG_SHAPE_REPRESENTATION('BOX_MINUS_SPHERE_REP',(#24),#14);
#26=SHAPE_DEFINITION_REPRESENTATION(#9,#25);
ENDSEC;
